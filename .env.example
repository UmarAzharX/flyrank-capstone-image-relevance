# Copy to app/.env only on a fresh setup; keep an existing app/.env.
# Replace the password placeholder with the local Docker Compose database password.
APP_NAME="FlyRank AI Image Relevance Capstone"
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:replace_with_local_password@127.0.0.1:5432/flyrank
# Add your own free-tier Gemini API key locally. Never commit it.
GEMINI_API_KEY=
AI_BUDGET_USD=0.0
AI_MAX_CALLS=200
VISION_CONFIDENCE_THRESHOLD=0.80
SIMILARITY_THRESHOLD=0.70
